# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL / Supabase) ─────────────────────
# Local: postgresql://postgres:postgres@localhost:5432/grape_master
# Supabase: use the "Connection string" from Project Settings → Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grape_master?schema=public"

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN=7d

# ── Supabase (Storage / optional auth) ───────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# ── PhonePe (Phase 4) ────────────────────────────────────
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX=1
PHONEPE_HOST="https://api-preprod.phonepe.com/apis/pg-sandbox"

# ── ML Service (Phase 5) ─────────────────────────────────
ML_SERVICE_URL="http://localhost:8000"
